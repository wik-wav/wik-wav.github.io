{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "portfolio-collection.schema.json",
  "title": "Portfolio collection",
  "type": "object",
  "required": ["schemaVersion", "recordType", "id", "order", "published", "draft", "titlePL", "titleEN", "summaryPL", "summaryEN", "cover", "hero", "thumbnail", "detailMediaSize"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "recordType": { "const": "collection" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "order": { "type": "number" },
    "published": { "type": "boolean" },
    "draft": { "type": "boolean" },
    "detailMediaSize": { "enum": ["compact", "standard", "large", "full"] },
    "heroLineHeightPL": { "type": "number", "minimum": 0.8, "maximum": 1.4, "default": 1.12 },
    "heroLineHeightEN": { "type": "number", "minimum": 0.8, "maximum": 1.4, "default": 1.12 },
    "editorialPL": { "type": "string", "default": "" },
    "editorialEN": { "type": "string", "default": "" },
    "detailSequenceIds": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "uniqueItems": true,
      "default": []
    },
    "detailSequence": {
      "type": "array",
      "items": { "$ref": "#/$defs/sequenceNode" },
      "default": []
    },
    "sequenceReveal": { "$ref": "#/$defs/sequenceReveal" }
  },
  "$defs": {
    "sequenceNode": {
      "oneOf": [
        {
          "type": "object",
          "required": ["id", "kind", "workId"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
            "kind": { "const": "work" },
            "workId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["id", "kind", "bodyPL", "bodyEN"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
            "kind": { "const": "text" },
            "headingPL": { "type": "string", "default": "" },
            "headingEN": { "type": "string", "default": "" },
            "bodyPL": { "type": "string" },
            "bodyEN": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    },
    "sequenceReveal": {
      "type": "object",
      "required": ["enabled", "afterId", "peekHeight"],
      "properties": {
        "enabled": { "type": "boolean" },
        "afterId": { "type": "string", "pattern": "^(?:|[a-z0-9]+(?:-[a-z0-9]+)*)$" },
        "peekHeight": { "enum": ["compact", "standard", "tall"] }
      },
      "if": { "properties": { "enabled": { "const": true } } },
      "then": { "properties": { "afterId": { "minLength": 1 } } },
      "additionalProperties": false
    }
  }
}
