{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "portfolio-site.schema.json",
  "title": "Portfolio site settings",
  "type": "object",
  "required": ["schemaVersion", "origin", "profile", "navigation", "copy", "home", "pages", "activity", "footer"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "origin": { "const": "https://wik-wav.github.io" },
    "profile": {
      "type": "object",
      "required": ["name", "email"],
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "linkedIn": { "type": "string", "format": "uri", "pattern": "^https://" },
        "socialLinks": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": ["id", "labelPL", "labelEN", "href"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
              "labelPL": { "type": "string" },
              "labelEN": { "type": "string" },
              "href": { "type": "string", "format": "uri", "pattern": "^https://" }
            }
          }
        }
      }
    },
    "navigation": { "type": "array", "items": { "type": "object", "required": ["id", "href", "labelPL", "labelEN"] } },
    "copy": { "type": "object" },
    "home": { "type": "object", "properties": { "heroLineHeight": { "type": "number", "minimum": 0.8, "maximum": 1.4, "default": 1.02 } } },
    "pages": { "type": "object" },
    "activity": {
      "type": "object",
      "required": ["eyebrowPL", "eyebrowEN", "headingPL", "headingEN", "introPL", "introEN", "itemsPerPage", "emptyPL", "emptyEN"],
      "properties": {
        "featuredUpdateId": { "type": "string" },
        "itemsPerPage": { "type": "integer", "minimum": 1, "maximum": 50 }
      }
    },
    "footer": { "type": "object" }
  }
}
